// Cloudflare deployment: a Worker that only serves the static files Astro builds.
// `npm run deploy` builds the site and uploads dist/ with `wrangler deploy`.
{
  "name": "portfolio",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    // /en and /en/ both resolve to /en/index.html
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with a 404 status
    "not_found_handling": "404-page"
  },
  // One address only: the site is served from its own domain, not from workers.dev
  "workers_dev": false,
  "preview_urls": false,
  // The domain lives in the same Cloudflare account, so wrangler creates the DNS
  // records and the certificates itself
  "routes": [
    { "pattern": "ismaeldelarosa.dev", "custom_domain": true },
    { "pattern": "www.ismaeldelarosa.dev", "custom_domain": true }
  ]
}
