---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './chapters/Hero.astro';
import Route from './chapters/Route.astro';
import Work from './chapters/Work.astro';
import HowAndProject from './chapters/HowAndProject.astro';
import Stack from './chapters/Stack.astro';
import Education from './chapters/Education.astro';
import Contact from './chapters/Contact.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Base locale={locale}>
  <Nav locale={locale} />
  <main id="main">
    <Hero locale={locale} />
    <Route locale={locale} />
    <Work locale={locale} />
    <HowAndProject locale={locale} />
    <Stack locale={locale} />
    <Education locale={locale} />
    <Contact locale={locale} />
  </main>
</Base>
