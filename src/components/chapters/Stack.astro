---
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).stack;
---

<section id="stack" class="relative py-28 md:py-40">
  <div class="container-page">
    <p class="eyebrow" data-reveal>{copy.eyebrow}</p>
    <h2 class="mt-4 text-4xl font-semibold tracking-[-0.03em] md:text-6xl" data-reveal>{copy.title}</h2>

    <!-- On scroll the groups arrive stacked like layers and spread into the grid (scripts/chapters/stack.ts). -->
    <div class="relative mt-14 grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-stack-grid>
      {
        copy.groups.map((group) => (
          <div class="min-w-0 rounded-2xl border border-line bg-panel p-6 shadow-[0_24px_48px_-32px_#000]" data-stack-layer>
            <h3 class="eyebrow">{group.name}</h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-full border border-line bg-ink px-3 py-1 text-sm">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
