---
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).education;
---

<section id="formacion" class="relative py-28 md:py-32">
  <div class="container-page">
    <p class="eyebrow" data-reveal>{copy.eyebrow}</p>
    <h2 class="mt-4 text-4xl font-semibold tracking-[-0.03em] md:text-5xl" data-reveal>{copy.title}</h2>

    <ol class="mt-12 divide-y divide-line border-y border-line">
      {
        copy.items.map((item) => (
          <li class="grid gap-2 py-6 md:grid-cols-[9rem_1fr] md:gap-8" data-reveal>
            <span class="font-mono text-sm text-muted tabular-nums">{item.years}</span>
            <div class="min-w-0">
              <h3 class="text-lg font-semibold tracking-tight">{item.title}</h3>
              <p class="text-muted">
                {item.place} · {item.note}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-8 grid gap-4 md:grid-cols-[9rem_1fr] md:gap-8" data-reveal>
      <span class="eyebrow pt-1">Cisco</span>
      <ul class="flex flex-wrap gap-2">
        {copy.also.map((cert) => <li class="rounded-full border border-line px-3 py-1 text-sm">{cert}</li>)}
      </ul>
    </div>
    <p class="mt-6 text-muted md:pl-[calc(9rem+2rem)]" data-reveal>{copy.languages}</p>
  </div>
</section>
