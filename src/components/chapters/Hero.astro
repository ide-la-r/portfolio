---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { profile, t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);

// The portrait is optional: drop src/assets/photo.(jpg|png|webp) in and it renders; without it the hero uses the full width.
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/photo.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(photos)[0]?.default;
---

<section data-hero class="relative flex min-h-[100svh] items-end pt-24 pb-14 md:items-center">
  <div class="container-page grid w-full items-center gap-12 lg:grid-cols-[1.25fr_1fr]">
    <div data-hero-copy class="min-w-0">
      {
        photo && (
          <Image
            data-hero-fade
            src={photo}
            alt=""
            width={96}
            height={96}
            densities={[1, 2]}
            class="mb-6 size-20 rounded-full object-cover object-[50%_26%] ring-1 ring-line lg:hidden"
          />
        )
      }
      <p data-hero-fade class="eyebrow mb-6">{copy.hero.location}</p>
      <h1
        data-hero-name
        class:list={[
          'leading-[0.92] font-semibold tracking-[-0.045em]',
          photo ? 'text-[clamp(3rem,min(10vw,14svh),6.75rem)]' : 'text-[clamp(3rem,min(10vw,15svh),8.5rem)]',
        ]}
      >
        Ismael<br /><span class="whitespace-nowrap">de la Rosa</span>
      </h1>
      <p data-hero-fade class="mt-6 text-xl font-medium tracking-tight md:text-2xl">{copy.hero.role}</p>
      <p data-hero-fade class="mt-4 max-w-[52ch] text-lg leading-relaxed text-muted">{copy.hero.summary}</p>
      <div data-hero-fade class="mt-8 flex flex-wrap gap-3 text-sm">
        <a href={profile.github} class="rounded-full border border-line px-4 py-2 transition-colors hover:border-muted">GitHub</a>
        <a href={profile.linkedin} class="rounded-full border border-line px-4 py-2 transition-colors hover:border-muted">LinkedIn</a>
      </div>
    </div>

    {
      photo && (
        <div data-hero-photo class="hero-portrait hidden lg:block">
          <Image
            src={photo}
            alt={copy.hero.photoAlt}
            widths={[480, 720, 960]}
            sizes="(min-width: 1024px) 34vw, 1px"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover object-[50%_30%]"
          />
        </div>
      )
    }
  </div>

  <div data-hero-stat class="container-page absolute inset-x-0 bottom-6 hidden md:block">
    <div data-hero-fade class="flex items-end justify-between gap-6">
      <div class="flex items-baseline gap-3 font-mono">
        <span class="text-sm text-off line-through decoration-off/60">340 ms</span>
        <span class="text-muted">→</span>
        <span class="text-3xl font-medium text-signal tabular-nums"><span data-hero-ms>2</span> ms</span>
        <span class="eyebrow ml-2">{copy.hero.statLabel}</span>
      </div>
      <a href="#trayectoria" class="eyebrow transition-colors hover:text-fg">{copy.hero.scroll} ↓</a>
    </div>
  </div>
</section>

<style>
  :global(html.motion) [data-hero-name] {
    visibility: hidden;
  }

  /* The portrait has no frame: a soft circle around its halo fades the rest into
     the page, so the figure seems to float on the same night as the site. The
     image's own background is a touch lighter than the page, hence no edges at all. */
  .hero-portrait {
    aspect-ratio: 4 / 5;
    max-height: 74svh;
    width: 100%;
    margin-left: auto;
    --portrait-mask: radial-gradient(circle closest-side at 50% 42%, #000 86%, transparent 116%);
    -webkit-mask-image: var(--portrait-mask);
    mask-image: var(--portrait-mask);
  }
</style>
