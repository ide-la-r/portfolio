---
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).work;
---

<section id="mainjobs" data-work class="relative py-28 md:py-40">
  <div class="container-page">
    <p class="eyebrow" data-reveal>{copy.eyebrow} · {copy.company} · {copy.period}</p>
    <h2 class="mt-4 max-w-[20ch] text-4xl font-semibold tracking-[-0.03em] md:text-6xl" data-reveal>{copy.title}</h2>
    <p class="mt-5 max-w-[60ch] text-lg text-muted" data-reveal>{copy.context}</p>

    <div class="mt-16 grid items-start gap-14 lg:grid-cols-[1fr_1.1fr]">
      <!-- The card: the record that travels through ingestion, shown here in its final, clean state. -->
      <div class="lg:sticky lg:top-28" data-reveal>
        <div class="relative rounded-2xl border border-line bg-panel p-6 shadow-[0_30px_60px_-30px_#000]">
          <span class="absolute -top-3 right-5 rounded-full bg-signal px-3 py-0.5 font-mono text-xs font-medium text-ink">scoring 82/100</span>
          <dl class="grid grid-cols-[auto_1fr] gap-x-5 gap-y-2.5 text-[0.95rem]">
            {
              copy.card.map((field) => (
                <>
                  <dt class="eyebrow pt-0.5">{field.label}</dt>
                  <dd class="min-w-0 tabular-nums">{field.value}</dd>
                </>
              ))
            }
          </dl>
          <p class="mt-5 font-mono text-[0.7rem] text-off">{copy.sample}</p>
        </div>

        <div class="mt-8 rounded-2xl border border-line p-6">
          <p class="eyebrow">{copy.latency.label}</p>
          <p class="mt-3 flex items-baseline gap-4 font-semibold tracking-[-0.04em]">
            <span class="text-2xl text-off line-through decoration-off/60">340 ms</span>
            <span class="text-6xl text-fg tabular-nums md:text-7xl">2<span class="ml-1 text-2xl font-medium text-muted">ms</span></span>
          </p>
          <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-line"><div class="h-full w-[0.6%] min-w-1 rounded-full bg-signal"></div></div>
        </div>
      </div>

      <ol class="grid gap-12">
        {
          copy.steps.map((step, i) => (
            <li class="min-w-0" data-reveal>
              <p class="font-mono text-xs text-signal">
                {String(i + 1).padStart(2, '0')} · {step.label}
              </p>
              <h3 class="mt-2 text-2xl font-semibold tracking-tight">{step.title}</h3>
              <p class="mt-3 text-lg leading-relaxed text-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
